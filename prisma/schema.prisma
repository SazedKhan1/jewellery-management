generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model category {
  id          Int       @id @default(autoincrement())
  name        String    @unique(map: "Category_name_key")
  description String?   @db.Text
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  product     product[]
}

model product {
  id                 Int                  @id @default(autoincrement())
  productCode        String               @unique(map: "Product_productCode_key")
  barcode            String?              @unique(map: "Product_barcode_key")
  name               String
  categoryId         Int
  jewelleryType      String?
  karat              String?
  purity             Decimal?             @db.Decimal(8, 3)
  grossWeight        Decimal              @default(0.000) @db.Decimal(10, 3)
  stoneWeight        Decimal              @default(0.000) @db.Decimal(10, 3)
  netWeight          Decimal              @default(0.000) @db.Decimal(10, 3)
  wastagePercent     Decimal              @default(0.000) @db.Decimal(8, 3)
  makingCharge       Decimal              @default(0.00) @db.Decimal(12, 2)
  stoneCharge        Decimal              @default(0.00) @db.Decimal(12, 2)
  purchasePrice      Decimal              @default(0.00) @db.Decimal(12, 2)
  sellingPrice       Decimal              @default(0.00) @db.Decimal(12, 2)
  stockQuantity      Int                  @default(0)
  status             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  category           category             @relation(fields: [categoryId], references: [id], map: "Product_categoryId_fkey")
  purchaseitem       purchaseitem[]
  purchasereturnitem purchasereturnitem[]
  stocktransaction   stocktransaction[]

  @@index([categoryId], map: "Product_categoryId_fkey")
}

model purchase {
  id             Int              @id @default(autoincrement())
  purchaseNo     String           @unique(map: "Purchase_purchaseNo_key")
  supplierId     Int
  purchaseDate   DateTime         @default(now())
  subtotal       Decimal          @default(0.00) @db.Decimal(12, 2)
  discount       Decimal          @default(0.00) @db.Decimal(12, 2)
  vat            Decimal          @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal          @default(0.00) @db.Decimal(12, 2)
  paidAmount     Decimal          @default(0.00) @db.Decimal(12, 2)
  dueAmount      Decimal          @default(0.00) @db.Decimal(12, 2)
  note           String?          @db.Text
  status         String           @default("COMPLETED")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  supplier       supplier         @relation(fields: [supplierId], references: [id], map: "Purchase_supplierId_fkey")
  purchaseitem   purchaseitem[]
  purchasereturn purchasereturn[]

  @@index([supplierId], map: "Purchase_supplierId_fkey")
}

model purchaseitem {
  id                 Int                  @id @default(autoincrement())
  purchaseId         Int
  productId          Int
  quantity           Int                  @default(1)
  grossWeight        Decimal              @default(0.000) @db.Decimal(10, 3)
  stoneWeight        Decimal              @default(0.000) @db.Decimal(10, 3)
  netWeight          Decimal              @default(0.000) @db.Decimal(10, 3)
  karat              String?
  rate               Decimal              @default(0.00) @db.Decimal(12, 2)
  makingCharge       Decimal              @default(0.00) @db.Decimal(12, 2)
  stoneCharge        Decimal              @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal              @default(0.00) @db.Decimal(12, 2)
  createdAt          DateTime             @default(now())
  product            product              @relation(fields: [productId], references: [id], map: "PurchaseItem_productId_fkey")
  purchase           purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade, map: "PurchaseItem_purchaseId_fkey")
  purchasereturnitem purchasereturnitem[]

  @@index([productId], map: "PurchaseItem_productId_fkey")
  @@index([purchaseId], map: "PurchaseItem_purchaseId_fkey")
}

model purchasereturn {
  id                 Int                  @id @default(autoincrement())
  returnNo           String               @unique(map: "PurchaseReturn_returnNo_key")
  purchaseId         Int
  supplierId         Int
  returnDate         DateTime             @default(now())
  subtotal           Decimal              @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal              @default(0.00) @db.Decimal(12, 2)
  note               String?              @db.Text
  status             String               @default("COMPLETED")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  purchase           purchase             @relation(fields: [purchaseId], references: [id], map: "PurchaseReturn_purchaseId_fkey")
  supplier           supplier             @relation(fields: [supplierId], references: [id], map: "PurchaseReturn_supplierId_fkey")
  purchasereturnitem purchasereturnitem[]

  @@index([purchaseId], map: "PurchaseReturn_purchaseId_fkey")
  @@index([supplierId], map: "PurchaseReturn_supplierId_fkey")
}

model purchasereturnitem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int
  purchaseItemId   Int
  productId        Int
  quantity         Int            @default(1)
  grossWeight      Decimal        @default(0.000) @db.Decimal(10, 3)
  stoneWeight      Decimal        @default(0.000) @db.Decimal(10, 3)
  netWeight        Decimal        @default(0.000) @db.Decimal(10, 3)
  rate             Decimal        @default(0.00) @db.Decimal(12, 2)
  makingCharge     Decimal        @default(0.00) @db.Decimal(12, 2)
  stoneCharge      Decimal        @default(0.00) @db.Decimal(12, 2)
  totalAmount      Decimal        @default(0.00) @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  product          product        @relation(fields: [productId], references: [id], map: "PurchaseReturnItem_productId_fkey")
  purchaseitem     purchaseitem   @relation(fields: [purchaseItemId], references: [id], map: "PurchaseReturnItem_purchaseItemId_fkey")
  purchasereturn   purchasereturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade, map: "PurchaseReturnItem_purchaseReturnId_fkey")

  @@index([productId], map: "PurchaseReturnItem_productId_fkey")
  @@index([purchaseItemId], map: "PurchaseReturnItem_purchaseItemId_fkey")
  @@index([purchaseReturnId], map: "PurchaseReturnItem_purchaseReturnId_fkey")
}

model stocktransaction {
  id              Int      @id @default(autoincrement())
  productId       Int
  transactionType String
  quantity        Int      @default(0)
  referenceType   String?
  referenceId     Int?
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  grossWeight     Decimal  @default(0.000) @db.Decimal(10, 3)
  netWeight       Decimal  @default(0.000) @db.Decimal(10, 3)
  stoneWeight     Decimal  @default(0.000) @db.Decimal(10, 3)
  product         product  @relation(fields: [productId], references: [id], map: "StockTransaction_productId_fkey")

  @@index([productId], map: "StockTransaction_productId_fkey")
}

model supplier {
  id              Int               @id @default(autoincrement())
  supplierCode    String            @unique(map: "Supplier_supplierCode_key")
  name            String
  phone           String?
  email           String?
  address         String?           @db.Text
  openingDue      Decimal           @default(0.00) @db.Decimal(12, 2)
  status          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  purchase        purchase[]
  purchasereturn  purchasereturn[]
  supplierpayment supplierpayment[]
}

model supplierpayment {
  id               Int      @id @default(autoincrement())
  paymentNo        String   @unique(map: "SupplierPayment_paymentNo_key")
  supplierId       Int
  paymentDate      DateTime @default(now())
  amount           Decimal  @default(0.00) @db.Decimal(12, 2)
  paymentMethod    String   @default("CASH")
  referenceNo      String?
  note             String?  @db.Text
  status           String   @default("COMPLETED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  paymentBreakdown String?  @db.LongText
  supplier         supplier @relation(fields: [supplierId], references: [id], map: "SupplierPayment_supplierId_fkey")

  @@index([supplierId], map: "SupplierPayment_supplierId_fkey")
}
// =====================================================
// CUSTOMER
// =====================================================

model Customer {
  id             Int       @id @default(autoincrement())

  customerCode   String    @unique
  name           String

  phone          String?
  email          String?
  address        String?   @db.Text

  openingDue     Decimal   @default(0) @db.Decimal(12, 2)
  openingAdvance Decimal   @default(0) @db.Decimal(12, 2)

  status         Boolean   @default(true)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}