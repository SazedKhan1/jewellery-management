generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =====================================================
// CATEGORY
// =====================================================

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  status      Boolean   @default(true)

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// =====================================================
// PRODUCT
// =====================================================

model Product {
  id              Int       @id @default(autoincrement())

  productCode     String    @unique
  barcode         String?   @unique

  name            String

  categoryId      Int
  category        Category  @relation(fields: [categoryId], references: [id])

  jewelleryType   String?

  karat           String?
  purity          Decimal?  @db.Decimal(8, 3)

  grossWeight     Decimal   @default(0) @db.Decimal(10, 3)
  stoneWeight     Decimal   @default(0) @db.Decimal(10, 3)
  netWeight       Decimal   @default(0) @db.Decimal(10, 3)

  wastagePercent  Decimal   @default(0) @db.Decimal(8, 3)

  makingCharge    Decimal   @default(0) @db.Decimal(12, 2)
  stoneCharge     Decimal   @default(0) @db.Decimal(12, 2)

  purchasePrice   Decimal   @default(0) @db.Decimal(12, 2)
  sellingPrice    Decimal   @default(0) @db.Decimal(12, 2)

  stockQuantity   Int       @default(0)

  status          Boolean   @default(true)

  stockTransactions StockTransaction[]
  purchases         PurchaseItem[]
  purchaseReturns   PurchaseReturnItem[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// =====================================================
// STOCK TRANSACTION
// =====================================================

model StockTransaction {
  id              Int      @id @default(autoincrement())

  productId       Int
  product         Product  @relation(fields: [productId], references: [id])

  transactionType String

  quantity        Int      @default(0)

  grossWeight     Decimal  @default(0) @db.Decimal(10, 3)
  stoneWeight     Decimal  @default(0) @db.Decimal(10, 3)
  netWeight       Decimal  @default(0) @db.Decimal(10, 3)

  referenceType   String?
  referenceId     Int?

  note            String?  @db.Text

  createdAt       DateTime @default(now())
}

// =====================================================
// SUPPLIER
// =====================================================

model Supplier {
  id           Int       @id @default(autoincrement())

  supplierCode String    @unique
  name         String

  phone        String?
  email        String?
  address      String?   @db.Text

  openingDue   Decimal   @default(0) @db.Decimal(12, 2)

  status       Boolean   @default(true)

  purchases    Purchase[]
  returns      PurchaseReturn[]
  payments     SupplierPayment[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// =====================================================
// PURCHASE
// =====================================================

model Purchase {
  id            Int           @id @default(autoincrement())

  purchaseNo    String        @unique

  supplierId    Int
  supplier      Supplier      @relation(fields: [supplierId], references: [id])

  purchaseDate  DateTime      @default(now())

  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  vat           Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)

  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal       @default(0) @db.Decimal(12, 2)

  note          String?       @db.Text

  status        String        @default("COMPLETED")

  items         PurchaseItem[]
  returns       PurchaseReturn[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// =====================================================
// PURCHASE ITEM
// =====================================================

model PurchaseItem {
  id              Int       @id @default(autoincrement())

  purchaseId      Int
  purchase        Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId       Int
  product         Product   @relation(fields: [productId], references: [id])

  quantity        Int       @default(1)

  grossWeight     Decimal   @default(0) @db.Decimal(10, 3)
  stoneWeight     Decimal   @default(0) @db.Decimal(10, 3)
  netWeight       Decimal   @default(0) @db.Decimal(10, 3)

  karat           String?
  rate            Decimal   @default(0) @db.Decimal(12, 2)

  makingCharge    Decimal   @default(0) @db.Decimal(12, 2)
  stoneCharge     Decimal   @default(0) @db.Decimal(12, 2)

  totalAmount     Decimal   @default(0) @db.Decimal(12, 2)

  returns         PurchaseReturnItem[]

  createdAt       DateTime  @default(now())
}

// =====================================================
// PURCHASE RETURN
// =====================================================

model PurchaseReturn {
  id            Int                 @id @default(autoincrement())

  returnNo      String              @unique

  purchaseId    Int
  purchase      Purchase            @relation(fields: [purchaseId], references: [id])

  supplierId    Int
  supplier      Supplier            @relation(fields: [supplierId], references: [id])

  returnDate    DateTime            @default(now())

  subtotal      Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal             @default(0) @db.Decimal(12, 2)

  note          String?             @db.Text

  status        String              @default("COMPLETED")

  items         PurchaseReturnItem[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// =====================================================
// PURCHASE RETURN ITEM
// =====================================================

model PurchaseReturnItem {
  id              Int             @id @default(autoincrement())

  purchaseReturnId Int
  purchaseReturn  PurchaseReturn  @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  purchaseItemId  Int
  purchaseItem    PurchaseItem    @relation(fields: [purchaseItemId], references: [id])

  productId       Int
  product         Product         @relation(fields: [productId], references: [id])

  quantity        Int             @default(1)

  grossWeight     Decimal         @default(0) @db.Decimal(10, 3)
  stoneWeight     Decimal         @default(0) @db.Decimal(10, 3)
  netWeight       Decimal         @default(0) @db.Decimal(10, 3)

  rate            Decimal         @default(0) @db.Decimal(12, 2)

  makingCharge    Decimal         @default(0) @db.Decimal(12, 2)
  stoneCharge     Decimal         @default(0) @db.Decimal(12, 2)

  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)

  createdAt       DateTime        @default(now())
}

// =====================================================
// SUPPLIER PAYMENT
// =====================================================

model SupplierPayment {
  id              Int       @id @default(autoincrement())

  paymentNo       String    @unique

  supplierId      Int
  supplier        Supplier  @relation(fields: [supplierId], references: [id])

  paymentDate     DateTime  @default(now())

  amount          Decimal   @default(0) @db.Decimal(12, 2)

  paymentMethod   String    @default("CASH")

  referenceNo     String?

  note            String?   @db.Text

  status          String    @default("COMPLETED")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}